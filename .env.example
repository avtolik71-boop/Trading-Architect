# .env — production secrets (DO NOT COMMIT)
# Copy to .env and fill in real values.

# vLLM
VLLM_API_KEY=not-needed-local

# PostgreSQL
PG_PASSWORD=changeme_prod

# Grafana
GRAFANA_PASSWORD=admin

# cTrader
CTRADER_HOST=host.docker.internal
CTRADER_PORT=8443
CTRADER_CLIENT_ID=your_client_id
CTRADER_CLIENT_SECRET=your_client_secret
CTRADER_ACCESS_TOKEN=your_token
CTRADER_ACCOUNT_ID=your_account_id

# Risk
DAILY_LOSS_LIMIT_PCT=5.0
MAX_POSITIONS=6
MAX_CORRELATION_EXPOSURE=0.70
PER_TRADE_RISK_PCT=1.5
MIN_TP_SL_RATIO=1.5

# Strategy
STRATEGY_STYLE=mean_reversion
SIGNAL_HORIZONS=5m,15m,1h,4h
ENSEMBLE_THRESHOLD_HIGH=0.75
ENSEMBLE_THRESHOLD_LOW=0.55